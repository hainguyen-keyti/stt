# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
WORKERS=1

# Database (MongoDB)
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/
DATABASE_NAME=video_pipeline_1

# JWT Authentication
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# External APIs
GEMINI_API_KEY=your-gemini-api-key

# Storage
MAX_UPLOAD_SIZE_MB=500

# Processing
MAX_CONCURRENT_TASKS=2
TASK_TIMEOUT_SECONDS=3600
CLEANUP_AFTER_HOURS=24

# Credits
CREDITS_PER_SECOND=1.0
FREE_CREDITS_ON_SIGNUP=600

# FFmpeg (optional, uses system default)
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Vivibe TTS - Auto refresh enabled
# Get refresh token from Firebase authentication
VIVIBE_REFRESH_TOKEN=your-vivibe-refresh-token
